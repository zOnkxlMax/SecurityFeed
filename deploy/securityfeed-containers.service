[Unit]
Description=Paketlisten der laufenden Container fuer SecurityFeed ablegen
Documentation=https://github.com/zOnkxlMax/SecurityFeed
After=docker.service
Requires=docker.service

[Service]
Type=oneshot

# Braucht Docker-Zugriff und laeuft deshalb als root - bewusst hier und nicht
# im SecurityFeed-Container, der ohne jede Docker-Berechtigung auskommt.
ExecStart=/opt/securityfeed/dump-container-packages.sh /var/lib/securityfeed/containers

TimeoutStartSec=300

# Haertung, soweit es mit Docker-Zugriff geht. Schreiben darf das Skript nur
# in die Ablage - und es muss den Docker-Socket erreichen; der liegt unter
# /run, das ProtectSystem=strict sonst ebenfalls nur lesend einhaengt. Das
# "-" laesst den jeweils nicht vorhandenen Pfad still aus.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/securityfeed -/run/docker.sock -/var/run/docker.sock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
