# Vorlage fuer /etc/securityfeed/securityfeed.env
#
# Kopieren und Werte eintragen:
#   sudo install -d -m 0750 -o root -g securityfeed /etc/securityfeed
#   sudo install -m 0640 -o root -g securityfeed \
#        deploy/securityfeed.env.example /etc/securityfeed/securityfeed.env
#
# ACHTUNG: Diese Datei enthaelt spaeter ein Passwort. Niemals ins Git committen -
# .gitignore blockt *.env, aber nicht wenn du sie umbenennst.

# --- SMTP-Relay -----------------------------------------------------------
SECFEED_SMTP_HOST=relay.intern.example
SECFEED_SMTP_PORT=587

# none     = unverschluesselt, Port 25 (nur fuer Relays im eigenen LAN)
# starttls = Port 587, Standard
# ssl      = implizites TLS, Port 465
SECFEED_SMTP_SECURITY=starttls

# Bei einem offenen Relay im LAN beide Zeilen auskommentiert lassen -
# ohne SECFEED_SMTP_USER wird gar kein LOGIN versucht.
#SECFEED_SMTP_USER=securityfeed@example.com
#SECFEED_SMTP_PASSWORD=

# --- Adressen -------------------------------------------------------------
SECFEED_MAIL_FROM=securityfeed@example.com
# Mehrere Empfaenger per Komma trennen
SECFEED_MAIL_TO=max@example.com
SECFEED_SUBJECT_PREFIX=[SecurityFeed]

# --- Zustand --------------------------------------------------------------
# Wird von der systemd-Unit ueber StateDirectory gesetzt; nur fuer cron noetig.
#SECFEED_STATE=/var/lib/securityfeed/seen.json
