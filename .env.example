# Vorlage fuer .env - von docker compose automatisch eingelesen.
#
#   cp .env.example .env
#   nano .env
#
# ACHTUNG: .env enthaelt dein Mailpasswort und ist per .gitignore
# ausgeschlossen. Niemals committen und nicht umbenennen.

# --- SMTP-Relay -----------------------------------------------------------
SECFEED_SMTP_HOST=smtp.firma.de
SECFEED_SMTP_PORT=587

# none     = unverschluesselt, Port 25 (nur fuer Relays im eigenen Netz)
# starttls = Port 587, Standardfall
# ssl      = implizites TLS, Port 465
SECFEED_SMTP_SECURITY=starttls

# Bei einem offenen Relay im eigenen Netz beide Zeilen auskommentiert lassen -
# ohne SECFEED_SMTP_USER wird gar keine Anmeldung versucht.
SECFEED_SMTP_USER=feed@firma.de
SECFEED_SMTP_PASSWORD=dein-app-passwort

# --- Adressen -------------------------------------------------------------
SECFEED_MAIL_FROM=feed@firma.de
# Mehrere Empfaenger per Komma trennen
SECFEED_MAIL_TO=max@firma.de
SECFEED_SUBJECT_PREFIX=[SecurityFeed]

# --- Zeitplan und Zeitzone ------------------------------------------------
# Hier anpassen, nicht in der compose.yaml - die bleibt so unveraendert und
# "git pull" kollidiert nicht mit lokalen Aenderungen.

# Uhrzeiten in lokaler Zeit, mehrere per Komma. Beispiele:
#   07:00            nur morgens
#   07:00,18:00      frueh und abends
#   07:00,13:00,18:00
SECFEED_SCHEDULE=07:00,18:00

# Zeitzone des Containers. Ohne passenden Wert laeuft der Zeitplan in UTC.
TZ=Europe/Berlin

# Wie weit zurueck geschaut wird (Tage). Puffer, falls ein Lauf ausfaellt -
# Wiederholungen verhindert der Zustandsspeicher, nicht dieser Wert.
SECFEED_SINCE=2

# Auch mailen, wenn es nichts Neues gibt - als Lebenszeichen, damit du merkst,
# wenn der Dienst stillsteht. Betreff lautet dann "keine neuen Meldungen",
# laesst sich also leicht filtern. Auf 1 setzen zum Aktivieren.
SECFEED_SEND_EMPTY=0

# --- Paketscan ------------------------------------------------------------
# Prueft zusaetzlich, welche der auf dem Pi installierten Pakete in einer
# verwundbaren Version vorliegen, und markiert Meldungen, die dieses System
# wirklich betreffen.
#
# Zum Aktivieren zwei Dinge noetig:
#   1. hier auf 1 setzen
#   2. in der compose.yaml den Mount der dpkg-Statusdatei entkommentieren
#
# Beachte: der Scan schickt die Liste deiner installierten Pakete samt
# Versionen an api.osv.dev. Deshalb ist er standardmaessig aus.
SECFEED_LOCAL=0

# Auch Luecken melden, gegen die es noch gar kein Update gibt. Deutlich mehr
# Rauschen - Debian stuft solche Faelle meist als geringfuegig ein.
SECFEED_LOCAL_UNFIXED=0

# Zusaetzlich die Pakete der anderen Container pruefen. Leer lassen = aus.
# Zum Einschalten auf /host/containers setzen; dazu gehoeren der Mount in der
# compose.override.yaml und der Timer auf dem Host, der die Listen ablegt -
# Rezept in docs/DOCKER.md, Abschnitt "Auch die anderen Container pruefen".
SECFEED_CONTAINER_LISTS=
