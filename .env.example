# Vorlage fuer .env - von docker compose automatisch eingelesen.
#
#   cp .env.example .env
#   nano .env
#
# ACHTUNG: .env enthaelt dein Mailpasswort und ist per .gitignore
# ausgeschlossen. Niemals committen und nicht umbenennen.

# --- SMTP-Relay -----------------------------------------------------------
SECFEED_SMTP_HOST=smtp.firma.de
SECFEED_SMTP_PORT=587

# none     = unverschluesselt, Port 25 (nur fuer Relays im eigenen Netz)
# starttls = Port 587, Standardfall
# ssl      = implizites TLS, Port 465
SECFEED_SMTP_SECURITY=starttls

# Bei einem offenen Relay im eigenen Netz beide Zeilen auskommentiert lassen -
# ohne SECFEED_SMTP_USER wird gar keine Anmeldung versucht.
SECFEED_SMTP_USER=feed@firma.de
SECFEED_SMTP_PASSWORD=dein-app-passwort

# --- Adressen -------------------------------------------------------------
SECFEED_MAIL_FROM=feed@firma.de
# Mehrere Empfaenger per Komma trennen
SECFEED_MAIL_TO=max@firma.de
SECFEED_SUBJECT_PREFIX=[SecurityFeed]

# --- Zeitplan und Zeitzone ------------------------------------------------
# Hier anpassen, nicht in der compose.yaml - die bleibt so unveraendert und
# "git pull" kollidiert nicht mit lokalen Aenderungen.

# Uhrzeiten in lokaler Zeit, mehrere per Komma. Beispiele:
#   07:00            nur morgens
#   07:00,18:00      frueh und abends
#   07:00,13:00,18:00
SECFEED_SCHEDULE=07:00,18:00

# Zeitzone des Containers. Ohne passenden Wert laeuft der Zeitplan in UTC.
TZ=Europe/Berlin

# Wie weit zurueck geschaut wird (Tage). Puffer, falls ein Lauf ausfaellt -
# Wiederholungen verhindert der Zustandsspeicher, nicht dieser Wert.
SECFEED_SINCE=2
